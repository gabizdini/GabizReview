rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'gabrielidinizds@gmail.com'
        ];
    }

    function isLikesOnlyUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount']);
    }

    match /reviews/{docId} {
      allow read: if true;
      allow create: if isAdmin();
      allow delete: if isAdmin();
      allow update: if isAdmin() || isLikesOnlyUpdate();
    }

    match /collections/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /currentlyReading/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
